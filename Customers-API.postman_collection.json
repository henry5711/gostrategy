{
  "info": {
    "name": "Users API",
    "description": "CRUD USER",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://go_strategy_api.io"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "dni",
      "value": "V26404237"
    },
    {
      "key": "email",
      "value": "henryrom57@example.com"
    },
    {
      "key": "User_id",
      "value": ""
    },
    {
      "key": "region_id",
      "value": ""
    },
    {
      "key": "commune_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// guarda el token Sanctum en la variable de coleccion para usarlo en los demas requests",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Usuario de prueba creado por el DatabaseSeeder: test@example.com / password. Emite un Personal Access Token , con expiracion segun config('sanctum.expiration')."
          }
        },
        {
          "name": "Login - Credenciales invalidas",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Debe responder 401 con success:false."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Registrar User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('User_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{dni}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"unaClaveSegura123\",\n  \"name\": \"Henry\",\n  \"last_name\": \"Romero\",\n  \"address\": \"Mi casa\",\n  \"region_id\": 1,\n  \"commune_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "Users"]
            },
            "description": "region_id/commune_id deben existir y estar relacionados (correr el seeder crea las regiones/comunas de ejemplo). dni y email no se pueden repetir. password es obligatorio y se guarda hasheado. Validado por StoreUserRequest."
          }
        },
        {
          "name": "Registrar User - Commune no relacionada (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"V99999999\",\n  \"email\": \"otro@example.com\",\n  \"password\": \"unaClaveSegura123\",\n  \"name\": \"Otro\",\n  \"last_name\": \"Persona\",\n  \"region_id\": 1,\n  \"commune_id\": 4\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "Users"]
            },
            "description": "commune_id 4 pertenece a otra region (segun el RegionSeeder). Debe responder 422."
          }
        },
        {
          "name": "Listar Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "Users"]
            },
            "description": "Lista Users. Todos los filtros son opcionales via query string (?dni=, ?email=, ?status=A, ?region_id=, ?commune_id=, ?name=, ?last_name=), nada es obligatorio. Sin filtros."
          }
        },
        {
          "name": "Listar Users - filtrado por status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?status=A",
              "host": ["{{base_url}}"],
              "path": ["api", "users"],
              "query": [{ "key": "status", "value": "A" }]
            },
            "description": "Ejemplo de filtro dinamico via User::scopeFilter(): status es un campo opcional mas, no un scope forzado aparte."
          }
        },
        {
          "name": "Consultar User por id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{User_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "Users", "{{User_id}}"]
            },
            "description": "Busca por id directo."
          }
        },
        {
          "name": "Editar User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Nueva direccion 123\",\n  \"region_id\": 1,\n  \"commune_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/{{User_id}}/update",
              "host": ["{{base_url}}"],
              "path": ["api", "Users", "{{User_id}}", "update"]
            },
            "description": ""
          }
        },
        {
          "name": "Eliminar User (logico)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{User_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "Users", "{{User_id}}"]
            },
            "description": "deleted_at via Eloquent SoftDeletes. Ejecutar dos veces seguidas para ver el mensaje 'Registro no existe' en la segunda."
          }
        },
        {
          "name": "Recuperar/activar User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{User_id}}/restore",
              "host": ["{{base_url}}"],
              "path": ["api", "Users", "{{User_id}}", "restore"]
            },
            "description": "Saca al User del trash y lo deja Activo (A). Solo funciona si el User esta actualmente en trash; si no, responde 422."
          }
        },
        {
          "name": "Users sin token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/users/{{User_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "Users", "{{User_id}}"]
            },
            "description": "Sin header Authorization. Debe responder 401."
          }
        }
      ]
    },
    {
      "name": "Regions",
      "item": [
        {
          "name": "Registrar Region",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('region_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metropolitana\",\n  \"description\": \"Region metropolitana\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/regions",
              "host": ["{{base_url}}"],
              "path": ["api", "regions"]
            },
            "description": "name es obligatorio y unico. Se crea con status Activo (A) por defecto. Validado por StoreRegionRequest."
          }
        },
        {
          "name": "Registrar Region - Nombre repetido (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metropolitana\",\n  \"description\": \"Duplicada\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/regions",
              "host": ["{{base_url}}"],
              "path": ["api", "regions"]
            },
            "description": "name debe ser unico en regions. Debe responder 422."
          }
        },
        {
          "name": "Listar Regions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/regions",
              "host": ["{{base_url}}"],
              "path": ["api", "regions"]
            },
            "description": "Lista Regions. Filtros opcionales via query string (?name=, ?status=A). Sin filtros."
          }
        },
        {
          "name": "Consultar Region por id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/regions/{{region_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "regions", "{{region_id}}"]
            },
            "description": "Busca por id directo."
          }
        },
        {
          "name": "Editar Region",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Metropolitana\",\n  \"description\": \"Descripcion actualizada\",\n  \"status\": \"A\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/regions/{{region_id}}/update",
              "host": ["{{base_url}}"],
              "path": ["api", "regions", "{{region_id}}", "update"]
            },
            "description": "Todos los campos son opcionales (sometimes). Validado por UpdateRegionRequest."
          }
        },
        {
          "name": "Eliminar Region",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/regions/{{region_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "regions", "{{region_id}}"]
            },
            "description": "Elimina la region. Si tiene communes asociadas responde 422."
          }
        },
        {
          "name": "Regions sin token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/regions",
              "host": ["{{base_url}}"],
              "path": ["api", "regions"]
            },
            "description": "Sin header Authorization. Debe responder 401."
          }
        }
      ]
    },
    {
      "name": "Communes",
      "item": [
        {
          "name": "Registrar Commune",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('commune_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"region_id\": {{region_id}},\n  \"name\": \"Providencia\",\n  \"description\": \"Comuna de Providencia\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/communes",
              "host": ["{{base_url}}"],
              "path": ["api", "communes"]
            },
            "description": "region_id debe existir en regions. name es obligatorio. Se crea con status Activo (A) por defecto. Validado por StoreCommuneRequest."
          }
        },
        {
          "name": "Registrar Commune - Region inexistente (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"region_id\": 999999,\n  \"name\": \"Comuna invalida\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/communes",
              "host": ["{{base_url}}"],
              "path": ["api", "communes"]
            },
            "description": "region_id 999999 no existe. Debe responder 422."
          }
        },
        {
          "name": "Listar Communes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/communes",
              "host": ["{{base_url}}"],
              "path": ["api", "communes"]
            },
            "description": "Lista Communes con su region relacionada. Filtros opcionales via query string (?name=, ?region_id=, ?status=A). Sin filtros."
          }
        },
        {
          "name": "Listar Communes - filtrado por region_id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/communes?region_id={{region_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "communes"],
              "query": [{ "key": "region_id", "value": "{{region_id}}" }]
            },
            "description": "Ejemplo de filtro por region_id."
          }
        },
        {
          "name": "Consultar Commune por id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/communes/{{commune_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "communes", "{{commune_id}}"]
            },
            "description": "Busca por id directo, incluye la region relacionada."
          }
        },
        {
          "name": "Editar Commune",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Providencia\",\n  \"description\": \"Descripcion actualizada\",\n  \"status\": \"A\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/communes/{{commune_id}}/update",
              "host": ["{{base_url}}"],
              "path": ["api", "communes", "{{commune_id}}", "update"]
            },
            "description": "Todos los campos son opcionales (sometimes). Validado por UpdateCommuneRequest."
          }
        },
        {
          "name": "Eliminar Commune",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/communes/{{commune_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "communes", "{{commune_id}}"]
            },
            "description": "Elimina la commune. Si tiene usuarios asociados (incluyendo soft-deleted) responde 422."
          }
        },
        {
          "name": "Communes sin token (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/communes",
              "host": ["{{base_url}}"],
              "path": ["api", "communes"]
            },
            "description": "Sin header Authorization. Debe responder 401."
          }
        }
      ]
    }
  ]
}
